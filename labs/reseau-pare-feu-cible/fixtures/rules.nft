table inet dsoxlab_filter {
  chain input {
    type filter hook input priority 0; policy drop;
    iifname "lo" accept
    ct state established,related accept
    ip saddr 172.30.201.0/24 icmp type echo-request accept
    ip saddr 172.30.201.0/24 tcp dport 8081 accept
  }
  chain forward {
    type filter hook forward priority 0; policy drop;
    ct state established,related counter accept
    ip saddr 172.30.201.20 counter drop comment "deny-untrusted"
    tcp dport 9090 counter drop comment "deny-debug"
    ip saddr 172.30.201.10 ip daddr 172.30.202.10 tcp dport 8089 counter accept comment "business"
    counter drop comment "deny-rest"
  }
  chain output {
    type filter hook output priority 0; policy accept;
  }
}
